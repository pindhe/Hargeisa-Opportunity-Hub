generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  passwordHash  String
  role          String   @default("student")
  profileImage  String?
  location      String?
  phone         String?
  emailVerified Boolean  @default(false)
  locale        String   @default("en")
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  profile       UserProfile?
  skills        UserSkill[]
  interests     UserInterest[]
  experiences   Experience[]
  languages     UserLanguage[]
  saved         SavedOpportunity[]
  applications  Application[]
  notifications Notification[]
  reports       Report[]
  tokens        AuthToken[]
  searches      SearchLog[]
}

model UserProfile {
  id                    Int     @id @default(autoincrement())
  userId                Int     @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  educationLevel        String?
  university            String?
  degree                String?
  field                 String?
  graduationYear        Int?
  gpa                   String?
  careerGoals           String?
  preferredLocations    String  @default("[]")
  preferredCategories   String  @default("[]")
  emailNotifications    Boolean @default(true)
  inAppNotifications    Boolean @default(true)
  browserNotifications  Boolean @default(false)
  deadlineReminders     Boolean @default(true)
  recommendationEmails  Boolean @default(true)
}

model Skill {
  id    Int         @id @default(autoincrement())
  name  String      @unique
  users UserSkill[]
}

model UserSkill {
  id      Int   @id @default(autoincrement())
  userId  Int
  skillId Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model Interest {
  id    Int            @id @default(autoincrement())
  name  String         @unique
  users UserInterest[]
}

model UserInterest {
  id         Int      @id @default(autoincrement())
  userId     Int
  interestId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([userId, interestId])
}

model Experience {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization String
  position     String
  startDate    DateTime
  endDate      DateTime?
  description  String?
}

model UserLanguage {
  id       Int    @id @default(autoincrement())
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  language String
  level    String @default("conversational")
}

model Organization {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  logo        String?
  description String?
  website     String?
  location    String?
  email       String?
  verified    Boolean  @default(false)
  status      String   @default("pending")
  isSample    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  opportunities Opportunity[]
}

model Opportunity {
  id                  Int      @id @default(autoincrement())
  organizationId      Int
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title               String
  slug                String   @unique
  category            String
  description         String
  requirements        String?
  benefits            String?
  applicationProcess  String?
  requiredDocuments   String   @default("[]")
  importantDates      String   @default("{}")
  location            String
  opportunityType     String   @default("offline")
  fundingType         String?
  educationLevel      String?
  field               String?
  skills              String   @default("[]")
  openingDate         DateTime?
  deadline            DateTime
  interviewDate       DateTime?
  resultDate          DateTime?
  applicationUrl      String?
  applicationMode     String   @default("external")
  contactEmail        String?
  status              String   @default("pending")
  featured            Boolean  @default(false)
  verified            Boolean  @default(false)
  isSample            Boolean  @default(false)
  viewCount           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tags         OpportunityTag[]
  savedBy      SavedOpportunity[]
  applications Application[]
  reports      Report[]
  reminders    DeadlineReminder[]

  @@index([category, status])
  @@index([deadline])
  @@index([status, featured])
  @@index([title])
}

model OpportunityTag {
  id            Int         @id @default(autoincrement())
  opportunityId Int
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  tag           String

  @@index([tag])
}

model SavedOpportunity {
  id            Int         @id @default(autoincrement())
  userId        Int
  opportunityId Int
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([userId, opportunityId])
}

model Application {
  id            Int         @id @default(autoincrement())
  userId        Int
  opportunityId Int
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status        String      @default("planning")
  appliedAt     DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([userId, opportunityId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model DeadlineReminder {
  id            Int         @id @default(autoincrement())
  userId        Int
  opportunityId Int
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  kind          String
  sentAt        DateTime    @default(now())

  @@unique([userId, opportunityId, kind])
}

model AuthToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Report {
  id            Int          @id @default(autoincrement())
  userId        Int
  opportunityId Int
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  reason        String
  description   String?
  status        String       @default("open")
  createdAt     DateTime     @default(now())
}

model SearchLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  query     String
  createdAt DateTime @default(now())
}

model PlatformSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}
